{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "720px", "wideSize": "1320px" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Carbón", "color": "#0e0e0d" },
				{ "slug": "surface", "name": "Grafito", "color": "#181816" },
				{ "slug": "contrast", "name": "Marfil", "color": "#ece7de" },
				{ "slug": "muted", "name": "Ceniza", "color": "#8d877d" },
				{ "slug": "accent", "name": "Latón", "color": "#c8a46a" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{ "slug": "display", "name": "Cormorant Garamond", "fontFamily": "\"Cormorant Garamond\", Georgia, serif" },
				{ "slug": "body", "name": "Inter", "fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Pequeña", "size": "0.8125rem" },
				{ "slug": "medium", "name": "Media", "size": "1.0625rem" },
				{ "slug": "large", "name": "Grande", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Extra grande", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3rem" } },
				{ "slug": "huge", "name": "Enorme", "size": "7rem", "fluid": { "min": "3.25rem", "max": "7rem" } }
			]
		},
		"spacing": {
			"units": ["px", "rem", "vh", "vw", "%"],
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "clamp(1.5rem, 3vw, 2.5rem)" },
				{ "slug": "40", "name": "L", "size": "clamp(2.5rem, 6vw, 5rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(4rem, 10vw, 9rem)" }
			]
		},
		"lightbox": { "enabled": true, "allowEditing": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"spacing": { "blockGap": "1.5rem", "padding": { "left": "var(--wp--preset--spacing--30)", "right": "var(--wp--preset--spacing--30)" } },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "400", "lineHeight": "1.05", "letterSpacing": "-0.01em" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "textDecoration": "none" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } }
			},
			"button": {
				"color": { "background": "transparent", "text": "var(--wp--preset--color--contrast)" },
				"border": { "width": "1px", "style": "solid", "color": "var(--wp--preset--color--contrast)", "radius": "0" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "letterSpacing": "0.18em", "textTransform": "uppercase" },
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "2rem", "right": "2rem" } },
				":hover": { "color": { "background": "var(--wp--preset--color--contrast)", "text": "var(--wp--preset--color--base)" } }
			},
			"caption": { "color": { "text": "var(--wp--preset--color--muted)" }, "typography": { "fontSize": "var(--wp--preset--font-size--small)" } }
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontSize": "1.75rem", "letterSpacing": "0.04em" }
			},
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "letterSpacing": "0.16em", "textTransform": "uppercase" }
			},
			"core/separator": { "color": { "text": "#2c2b28" } },
			"core/gallery": { "spacing": { "blockGap": "0.75rem" } },
			"core/post-date": { "color": { "text": "var(--wp--preset--color--muted)" }, "typography": { "fontSize": "var(--wp--preset--font-size--small)", "letterSpacing": "0.12em", "textTransform": "uppercase" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Cabecera", "area": "header" },
		{ "name": "footer", "title": "Pie de página", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-full", "title": "Página a ancho completo", "postTypes": ["page"] }
	]
}
